--- new file ipir-sp/examples/native_radix.rs
//! PROTOTYPE ONLY. Radix samples: two 4-bit rows per LWE sample.
//! Merged entry c = D0 + 256*D1 (< 4096); profile p = 2^12 so the server accepts c.
//! Target (g, j): selection scale q/16 (j = 0, shift 8) or q/4096 (j = 1, shift 0).
//! Phase = D_j*q/16 + [j=1] D0*q/4096 + noise; higher digit vanishes mod q.
//! Args: merged_rows cols ell base samples mask_bits.
use ipir_sp::native::*;
use rand_chacha::{rand_core::{RngCore, SeedableRng}, ChaCha20Rng};
use reinspiring::native::*;
use std::time::Instant;
fn main() {
    let a: Vec<usize> = std::env::args().skip(1).map(|x| x.parse().unwrap()).collect();
    let (rows, cols, ell, base, samples, mask_bits) = (a[0], a[1], a[2], a[3], a[4], a[5]);
    let pack = NativeParams::new(2048, 54, 12, base as u32, ell, SecretDistribution::Gaussian).unwrap();
    let profile = NativeProfile::new(pack, rows, cols).unwrap()
        .with_two_mask_output().unwrap().with_published_mask_bits(mask_bits).unwrap();
    let setup = NativePublicSetup::new(profile, [7; 32], [19; 32]);
    let mut rng = ChaCha20Rng::seed_from_u64(0x2417);
    // digits[j][col*rows + r]
    let d0: Vec<u16> = (0..rows * cols).map(|_| (rng.next_u32() & 15) as u16).collect();
    let d1: Vec<u16> = (0..rows * cols).map(|_| (rng.next_u32() & 15) as u16).collect();
    let db: Vec<u16> = d0.iter().zip(&d1).map(|(x, y)| x + 256 * y).collect();
    let t = Instant::now();
    let server = NativeServer::build_with_concurrency(setup, db, 1).unwrap();
    let offline = t.elapsed().as_secs_f64();
    let published = NativePublished::from_bytes(server.setup(), &server.published().to_bytes()).unwrap();
    println!("{}", serde_json::json!({"kind":"setup","rows_merged":rows,"logical_rows":2*rows,"cols":cols,"ell":ell,"base":base,"offline_s":offline,"published_bytes":published.to_bytes().len()}));
    let mut qrng = ChaCha20Rng::seed_from_u64(0x2418);
    let q = 1u128 << 54;
    for i in 0..samples {
        let logical = [0, rows - 1, rows, 2 * rows - 1, rows / 2 * 2 + 1, 7][i % 6].min(2 * rows - 1);
        let (g, j) = (logical / 2, logical % 2);
        std::env::set_var("PROTO_SEL_SHIFT", if j == 0 { "8" } else { "0" });
        let request = NativeRequest::generate_with_rng(server.setup(), g, &mut qrng).unwrap();
        std::env::remove_var("PROTO_SEL_SHIFT");
        let t = Instant::now();
        let (response, timing) = server.respond(request.bytes()).unwrap();
        let server_ms = t.elapsed().as_secs_f64() * 1000.;
        // expected phase in q/4096 units: 256*D_j + (j==1 ? D0 : 0)
        let expected: Vec<u64> = (0..cols).map(|c| {
            let k = c * rows + g;
            if j == 0 { 256 * d0[k] as u64 } else { 256 * d1[k] as u64 + d0[k] as u64 }
        }).collect();
        let (decoded, err) = request.decode_with_error(&published, &response, &expected).unwrap();
        let mut ok = true;
        for c in 0..cols {
            let k = c * rows + g;
            let want = if j == 0 { d0[k] } else { d1[k] } as u64;
            let got = ((decoded[c] + 4096 - 8 + 128) / 256) % 16;
            ok &= got == want;
        }
        let _ = q;
        println!("{}", serde_json::json!({"kind":"sample","logical_row":logical,"group":g,"digit":j,"correct":ok,"phase_error_vs_expected":err,"radius_q16":1u64<<49,"server_ms":server_ms,"matvec_ms":timing.matrix_vector.as_secs_f64()*1000.,"packing_ms":timing.packing.as_secs_f64()*1000.,"upload_bytes":request.bytes().len(),"download_bytes":response.len()}));
    }
}
